                "BTTMenuItemShadowColor" : "0.000000, 0.000000, 0.000000, 255.000000",
                "BTTMenuItemIconPosition" : 1,
                "BTTMenuScriptSettings" : {
                  "BTTScriptType" : 3,
                  "BTTAppleScriptString" : "\n\nfunction slightlyAdjustColor(color) {\n  const adjust = (component) => Math.max(0, Math.min(255, component + (Math.random() * 40 - 20)));\n  return {\n    r: adjust(color.r),\n    g: adjust(color.g),\n    b: adjust(color.b),\n  };\n}\n\n\nasync function itemScript(itemUUID) {\n  const now = new Date();\n  const timeString = now.toLocaleTimeString();\n  \n  let currentColorString = await get_string_variable(\"BTTClockExampleBackgroundColor\");\n  \n  let currentColor = currentColorString ? JSON.parse(currentColorString) : undefined;\n  if(currentColor == undefined) {\n  currentColor = {\n  r: Math.floor(Math.random() * 256),\n  g: Math.floor(Math.random() * 256),\n  b: Math.floor(Math.random() * 256),\n};\n  \n  }\n  \n  \n  await set_string_variable({variableName: \"BTTClockExampleBackgroundColor\", to: JSON.stringify(currentColor)});\n  \n  // Slightly change the color each time\n  currentColor = slightlyAdjustColor(currentColor);\n\n  const colorString = `${Math.round(currentColor.r)}, ${Math.round(currentColor.g)}, ${Math.round(currentColor.b)}, 180`;\n\n  const content = {\n    BTTMenuItemBackgroundColor: colorString,\n    BTTMenuItemText: timeString\n  };\n\n  return JSON.stringify(content);\n}\n",
                  "BTTScriptFunctionToCall" : "itemScript",
                  "BTTScriptLocation" : 0,
                  "BTTAppleScriptUsePath" : false,
                  "BTTJavaScriptUseIsolatedContext" : false
                },
