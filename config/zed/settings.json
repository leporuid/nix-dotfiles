{
  "on_new_window": "readme",
  "when_closing_with_no_tabs": "keep_window_open",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "autosave": "on_focus_change",
  "accessible_mode": true,
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "shell": {
      "with_arguments": {
        "program": "/bin/sh",
        "args": [
          "-c",
          "/bin/wait4path /nix/store && exec -l \"$SHELL\""
        ]
      }
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "helix_mode": true,
  "status_bar": {
    "active_encoding_button": "enabled"
  },
  "redact_private_values": true,
  "session": {
    "trust_all_worktrees": true
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "buffer_font_weight": 400.0,
  "ui_font_weight": 390.0,
  "icon_theme": "Catppuccin Mocha",
  "theme": {
    "mode": "system",
    "light": "Glass-Day",
    "dark": "Glass"
  },
  "vim_mode": false,
  "buffer_font_family": "Maple Mono NF CN",
  "ui_font_family": "Maple Mono NF CN",
  "format_on_save": "off"
}
