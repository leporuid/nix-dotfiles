{
  "on_new_window": "readme",
  "when_closing_with_no_tabs": "keep_window_open",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "autosave": "on_focus_change",
  "accessible_mode": true,
  "terminal": {
    "working_directory": "current_file_directory",
    "toolbar": {
      "breadcrumbs": true
    },
    "shell": "system"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "helix_mode": true,
  "status_bar": {
    "active_encoding_button": "enabled"
  },
  "redact_private_values": true,
  "session": {
    "trust_all_worktrees": true
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "buffer_font_weight": 400.0,
  "ui_font_weight": 390.0,
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha Monochrome",
    "dark": "Catppuccin Mocha"
  },
  "theme": {
    "mode": "system",
    "light": "Glass-Day",
    "dark": "Glass"
  },
  "vim_mode": false,
  "buffer_font_family": "Maple Mono NF CN",
  "ui_font_family": "Maple Mono NF CN",
  "format_on_save": "off"
}
